"use strict";

/* =========================
   CINEMATIC INTRO
   ========================= */
const intro = document.getElementById("cinematic-intro") || document.getElementById("intro");
const video = document.getElementById("intro-video") || intro?.querySelector("video");
const text = document.querySelector(".intro-text");
const skip = document.getElementById("intro-skip");

if (intro) {
  let ended = false;

  if (text) {
    setTimeout(() => text.classList.add("show"), 1200);
  }

  function endIntro() {
    if (ended) return;
    ended = true;

    intro.classList.add("fade-out");
    setTimeout(() => intro.remove(), 1200);
  }

  if (video) video.addEventListener("ended", endIntro);
  if (skip) skip.addEventListener("click", endIntro);

  document.addEventListener("keydown", e => {
    if (e.key === "Escape") endIntro();
  });

  setTimeout(endIntro, 12000);
}

